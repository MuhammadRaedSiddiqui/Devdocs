{
  "compilerOptions": {
    "target":             "ES2020",
    "lib":                ["ES2020"],
    "types":              ["node"],
    "module":             "ES2020",
    "moduleResolution":   "Bundler",
    "strict":             true,
    "noEmit":             true,
    "esModuleInterop":    true,
    "skipLibCheck":       true,
    "resolveJsonModule":  true,
    "paths": {
      "@devdocs/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src", "../../packages/shared/src"],
  "exclude": ["node_modules", "dist"]
}
