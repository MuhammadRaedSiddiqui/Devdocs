{
  "compilerOptions": {
    "target":            "ES2020",
    "lib":               ["ES2020", "dom"],
    "module":            "esnext",
    "moduleResolution":  "bundler",
    "strict":            true,
    "declaration":       true,
    "noEmit":            true,
    "skipLibCheck":      true,
    "esModuleInterop":   true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
